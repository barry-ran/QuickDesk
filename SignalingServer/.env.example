# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Run GORM AutoMigrate on startup. Keep disabled in production after the
# schema has been initialized to avoid expensive information_schema scans.
RUN_AUTO_MIGRATE=true

# Optional Go pprof debug endpoint. Leave empty unless you are actively
# diagnosing memory/CPU issues. Only loopback addresses are accepted.
# Example: PPROF_ADDR=127.0.0.1:6060
PPROF_ADDR=

# Application logs. In Docker, LOG_DIR defaults to /data/logs so logs persist
# alongside PostgreSQL and Redis data. Each file rotates at LOG_MAX_SIZE_MB;
# LOG_MAX_BACKUPS rotated files are retained in addition to the active file.
LOG_DIR=logs
LOG_MAX_SIZE_MB=50
LOG_MAX_BACKUPS=5

# PostgreSQL Database (deployed on localhost)
DB_HOST=localhost
DB_PORT=5432
DB_USER=quickdesk
DB_PASSWORD=quickdesk123
DB_NAME=quickdesk_signaling

# Redis (deployed on localhost)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ========== ICE Configuration ==========
# TURN server addresses (separated by commas)
TURN_URLS=turn:turn.quickcoder.cc:3478

# coturn shared secret (must match static-auth-secret in coturn configuration)
TURN_AUTH_SECRET=xxxxxxx

# TURN credential validity time (seconds), default 86400 (24 hours)
TURN_CREDENTIAL_TTL=86400

# STUN server
STUN_URLS=stun:stun.quickcoder.cc:3478

# Admin account (for management interface login)
ADMIN_USER=admin
ADMIN_PASSWORD=admin

# API Key for client authentication (empty = disabled, any client can connect)
# Set this to restrict access to official clients only.
# Clients must send this key via X-API-Key header or api_key query parameter.
API_KEY=

# Prometheus text metrics. Empty disables /metrics entirely. When set, the
# endpoint is exposed and scrapers must send `Authorization: Bearer <token>`.
# Keep it different from API_KEY so a metrics credential does not also become
# a client credential.
METRICS_TOKEN=

# Allowed origins for WebClient (comma-separated, empty = disabled)
# Browsers automatically send the Origin header which cannot be spoofed by JS.
# Only pages loaded from these origins can access the signaling server.
# Example: https://web.quickdesk.cc,https://quickdesk.example.com
ALLOWED_ORIGINS=

# Signs the proof-of-possession challenges a key-bound access grant requires
# (POST /v1/devices/:id/controller-challenges). Empty falls back to API_KEY, so
# an existing deployment can bind a grant to a controller key with no new
# setting; set it explicitly to keep the two secrets independent.
CONTROLLER_CHALLENGE_SECRET=

# Peers whose X-Forwarded-For header is believed (comma-separated IPs/CIDRs).
# Everything that keys on a client address - allow_ips, approval_trusted_ips,
# the per-IP rate limits, the access log - uses this header when the peer is on
# the list, and the socket address otherwise.
#   (empty)  loopback + private ranges: the usual "reverse proxy on this host
#            or on the LAN" topology
#   none     trust nobody; use this when the server is exposed directly
# Anything else has to name the proxy, e.g. 10.1.0.0/16,127.0.0.1/32.
# An unparseable entry is fatal at startup rather than ignored, because
# silently falling back would leave the IP gates spoofable.
TRUSTED_PROXIES=

# Statutory holiday calendar for device access policy exception dates.
# Leave empty to use the year(s) compiled into the binary (currently the 2026
# CN arrangement from the State Council notice). Point it at a directory of
# holiday-cn style YYYY.json files to add a year without rebuilding - drop in
# next year's file and restart. See internal/holiday/cn-2026.json for the shape.
HOLIDAY_CALENDAR_DIR=

# Optional: download the holiday-cn year files instead of waiting for someone
# to copy them in. Either a template containing {year} or a base URL that
# /<year>.json is appended to, e.g.
# https://cdn.jsdelivr.net/npm/holiday-cn@latest/{year}.json
# Requires HOLIDAY_CALENDAR_DIR as the cache; a failed fetch keeps the existing
# files, and a file that does not parse is never written.
HOLIDAY_CALENDAR_URL=
# How often to re-check, in minutes. 0 = fetch once at startup and never again.
HOLIDAY_CALENDAR_REFRESH_MINUTES=0

# Aliyun SMS (optional – leave all empty to disable phone number features)
# When disabled, SMS login/register verification is not available.
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# Audit-log retention. 0 (the default) keeps every audit row forever. A positive
# value deletes rows older than the window on a timer, and the admin endpoint
# POST /v1/admin/audit-logs:sweep runs the same purge on demand.
# AUDIT_ARCHIVE_DIR, when set, appends expired rows to a daily JSONL file before
# deleting them - recommended, because the trail exists to be evidence and a
# plain delete is irreversible.
AUDIT_RETENTION_DAYS=0
AUDIT_SWEEP_INTERVAL_MINUTES=60
AUDIT_ARCHIVE_DIR=
# Optional cold storage for expired daily archive files. When set, archive
# rotation moves the file here instead of deleting it; a move failure leaves the
# hot file in place and fails the sweep.
AUDIT_ARCHIVE_COLD_DIR=
# Row caps, independent of the age window above; any one bound alone starts the
# sweep. AUDIT_MAX_ROWS bounds the whole table. AUDIT_MAX_ROWS_PER_ACTOR bounds
# each admin/user separately; AUDIT_MAX_ROWS_PER_DEVICE bounds one device's
# trail; AUDIT_MAX_ROWS_PER_ACTION bounds one action type. The targeted caps
# run before the table-wide one so a noisy actor/device/action pays its own old
# rows instead of evicting everyone else's trail. 0 = no cap.
AUDIT_MAX_ROWS=0
AUDIT_MAX_ROWS_PER_ACTOR=0
AUDIT_MAX_ROWS_PER_DEVICE=0
AUDIT_MAX_ROWS_PER_ACTION=0

# Cross-instance log aggregation. Off (the default) keeps this process's log
# local. When on, every line is also copied into the shared database
# (instance_log_entries) so `GET /v1/admin/system/logs:search?scope=all` covers
# every instance, not just the one that answered the request. The copy is
# best-effort: the authoritative log stays the rotating file next to it, and the
# search response reports how many lines this process stored or had to drop.
INSTANCE_LOG_SINK=false
# How long shipped copies are kept. Short on purpose - this table is a
# convenience for cross-instance search, not the record of what happened.
INSTANCE_LOG_RETENTION_DAYS=7
INSTANCE_LOG_SWEEP_INTERVAL_MINUTES=30

# Optional: the PostgreSQL and Redis log files. Setting a path makes it readable
# through `logs:search?file=postgres.log|redis.log`, and - when INSTANCE_LOG_SINK
# is on - followed read-only from its current end so the lines land in the shared
# store and `scope=all` covers them too. Rotation is detected by inode on
# Linux/macOS and by a shrinking file on Windows.
POSTGRES_LOG_FILE=
REDIS_LOG_FILE=

# Notification-delivery outbox retention. 0 keeps terminal rows forever.
# NOTIFICATION_ARCHIVE_DIR archives rows before deletion; the cold directory
# moves expired daily archive files there instead of deleting them.
NOTIFICATION_RETENTION_DAYS=0
NOTIFICATION_SWEEP_INTERVAL_MINUTES=60
NOTIFICATION_ARCHIVE_DIR=
NOTIFICATION_ARCHIVE_COLD_DIR=
NOTIFICATION_ARCHIVE_RETENTION_DAYS=0

# Remote-session orphan sweep. A session row whose signaling instance is no
# longer alive (its presence lease expired) is stamped `server_restart`; the
# pass runs at boot and then on this interval. 0 disables the periodic pass.
REMOTE_SESSION_SWEEP_INTERVAL_MINUTES=1

# After a session is revoked (owner kick, admin kick, or a device-wide clear),
# refuse a new controller from the same device + source address for this many
# seconds: the access code is still valid, so closing the socket alone would make
# the kick cosmetic. Five minutes matches the approval denial cooldown; 0 allows
# immediate reconnects.
REVOKE_COOLDOWN_SECONDS=300

# Notification aggregation (noise reduction). 0 (the default) delivers every
# event as its own webhook immediately. A positive value holds each new
# notification for that many seconds and folds later events with the same
# (channel, event type, device) into it - the receiver then sees one message
# carrying `aggregated_count` instead of one message per occurrence. The
# trade-off is a deliberate delay of up to this window before anything is sent.
NOTIFICATION_AGGREGATE_SECONDS=0

# Worker behind owner-scheduled control-plane actions (see the scheduled-tasks
# section of docs/user-api-docs.md): "sign out everywhere at 22:00", and every
# night after. 0 disables the worker entirely; a tick with nothing due is one
# indexed query, so the 30s default is cheap.
SCHEDULED_TASK_INTERVAL_SECONDS=30

# Second-factor approval: how long a source whose request the owner DENIED must
# wait before it may ask the same device again. The default is non-zero on
# purpose - a denial that immediately frees the source to ask again is what
# turns a correct access code into a way to keep paging the owner. 0 disables it
# (a denial then clears the way at once, the historical behaviour).
APPROVAL_DENIAL_COOLDOWN_SECONDS=300

# Repeated denials from one source can cost more: with a multiplier of N, the
# k-th consecutive refusal from the same (device, source) waits
# APPROVAL_DENIAL_COOLDOWN_SECONDS * N^(k-1). The default of 1 keeps the window
# constant, which is what deployments had before escalation existed.
APPROVAL_DENIAL_COOLDOWN_MULTIPLIER=1
# Ceiling for that growth, in seconds. 0 means uncapped - set it whenever the
# multiplier is above 1, or a long enough streak grows the window without
# bound.
APPROVAL_DENIAL_COOLDOWN_MAX_SECONDS=0

# Self-hosted update channel, artifact re-hosting. A release can always point at
# a URL the operator hosts (download_url); these settings are for the other
# option, where the installer is uploaded to this server through
# POST /v1/admin/update-releases/:id/artifact and served from
# GET /v1/update-releases/:id/artifact.
#
# Where the uploaded installers land. Like the recording store, this directory
# is not a static site - the bytes only leave through the API-key-gated download
# route, so it is safe to keep it outside the web root.
UPDATE_ARTIFACT_DIR=data/updates
# Cap on a single installer upload. The admin UI posts the whole file in one
# request, so this is also the practical size limit of a re-hosted build.
UPDATE_MAX_UPLOAD_MB=4096
# Absolute prefix for the download_url stored on a re-hosted release, e.g.
# https://updates.example.com. Set this whenever a reverse proxy terminates TLS
# in front of the server: with it empty the URL is built from the host on the
# admin upload request, which is http:// behind an HTTPS proxy.
UPDATE_PUBLIC_BASE_URL=

# Cleanup of the update artifact store. A resumable upload only removes its
# staging file when it finishes, and a release row only removes its artifact when
# it is deleted, so an upload nobody came back to would otherwise sit on disk
# forever. Every UPDATE_SWEEP_INTERVAL_MINUTES the server deletes
#   - a `.part` file untouched for UPDATE_STALE_UPLOAD_MINUTES (an abandoned
#     upload: a paused upload older than this has to restart from zero), and
#   - a stored artifact older than an hour that no release row claims (the
#     crash-shaped case where the rename happened and the database write did not).
# 0 minutes of interval disables the worker; POST /v1/admin/update-releases:sweep
# still runs the same pass on demand.
UPDATE_STALE_UPLOAD_MINUTES=360
UPDATE_SWEEP_INTERVAL_MINUTES=60
