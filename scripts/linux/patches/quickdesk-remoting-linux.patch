+
+  base::Value::Dict message;
+  message.Set(kMessageType, kClientConnectedMessage);
+  message.Set(kClientId, client_id);
+  message.Set(kClientUsername, client_username);
+  message.Set(kDeviceId, std::string());
+  SendMessageToClient(std::move(message));
+}
+
+void QuickDeskNativeMessagingHost::OnClientDisconnected(
