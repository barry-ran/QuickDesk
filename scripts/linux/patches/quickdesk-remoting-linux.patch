+// Parses the Qt ICE config shape:
+// {"iceServers": [{"urls": [...], "username": ..., "credential": ...}]}.
+protocol::IceConfig ParseIceConfig(const base::Value::Dict& dict) {
+  protocol::IceConfig ice_config;
+  const base::Value::List* servers = dict.FindList("iceServers");
+  if (!servers) {
+    return ice_config;
+  }
+
+  bool has_server = false;
+  for (const base::Value& value : *servers) {
+    const base::Value::Dict* server = value.GetIfDict();
+    if (!server) {
+      continue;
+    }
+
+    std::string username;
+    if (const std::string* username_value = server->FindString("username")) {
+      username = *username_value;
+    }
+    std::string credential;
+    if (const std::string* credential_value =
+            server->FindString("credential")) {
+      credential = *credential_value;
+    }
+
+    std::vector<std::string> urls;
+    if (const base::Value::List* urls_list = server->FindList("urls")) {
+      for (const base::Value& url : *urls_list) {
+        if (url.is_string()) {
+          urls.push_back(url.GetString());
+        }
+      }
+    } else if (const std::string* url = server->FindString("urls")) {
+      urls.push_back(*url);
+    }
+
+    for (const std::string& url : urls) {
+      if (ice_config.AddServer(url, username, credential)) {
+        has_server = true;
+      }
+    }
+  }
+
+  if (has_server) {
+    // QuickDesk feeds a static, user-configured server list that never
+    // expires; mark it valid to avoid triggering a fetch.
+    ice_config.expiration_time = base::Time::Now() + base::Hours(24);
+  }
+  return ice_config;
 }
 
