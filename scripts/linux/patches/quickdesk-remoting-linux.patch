+// Thin JSON-over-HTTP client for the QuickDesk signaling server's v1 device
+// API. Must be used on the thread that owns |url_loader_factory|.
+class QuickDeskApiClient {
+ public:
+  struct ProvisionResult {
+    std::string device_id;
+    std::string device_secret;
+    bool is_new = false;
+  };
+
+  using ProvisionCallback = base::OnceCallback<void(
+      std::optional<ProvisionResult> result,
+      const std::string& error)>;
+  using TokenCallback =
+      base::OnceCallback<void(std::string signal_token,
+                              const std::string& error)>;
+  using ResultCallback =
+      base::OnceCallback<void(bool success, const std::string& error)>;
+
+  // |server_url| is the base URL configured in the UI; it may use http(s),
+  // ws(s) and may or may not include the "/v1/realtime/signal" suffix.
+  QuickDeskApiClient(network::mojom::URLLoaderFactory* url_loader_factory,
+                     const std::string& server_url,
+                     const std::string& api_key);
+
+  QuickDeskApiClient(const QuickDeskApiClient&) = delete;
+  QuickDeskApiClient& operator=(const QuickDeskApiClient&) = delete;
+
+  ~QuickDeskApiClient();
+
+  // POST /v1/devices:provision (X-API-Key). Rotates the device secret for an
+  // existing device_uuid.
+  void Provision(const std::string& device_uuid,
+                 const std::string& machine_fingerprint,
+                 const std::string& os,
+                 const std::string& os_version,
+                 const std::string& app_version,
+                 ProvisionCallback callback);
+
+  // POST /v1/devices/{id}/signal-tokens (Bearer device secret).
+  void IssueSignalToken(const std::string& device_id,
+                        const std::string& device_secret,
+                        TokenCallback callback);
+
+  // POST /v1/devices/{id}/heartbeat (Bearer device secret).
+  void Heartbeat(const std::string& device_id,
+                 const std::string& device_secret,
+                 const std::string& app_version,
+                 const std::string& os,
+                 const std::string& os_version,
+                 ResultCallback callback);
+
+  // PUT /v1/devices/{id}/access-code (Bearer device secret).
+  void SetAccessCode(const std::string& device_id,
+                     const std::string& device_secret,
+                     const std::string& access_code,
+                     ResultCallback callback);
+
+  // Converts the configured server URL to an http(s) base URL, without a
+  // trailing slash.
+  static std::string GetHttpBaseUrl(const std::string& server_url);
+
+  // Returns the WebSocket URL for /v1/realtime/signal.
+  static std::string GetSignalUrl(const std::string& server_url);
+
+ private:
+  using HttpResponseCallback =
+      base::OnceCallback<void(int response_code,
+                              std::optional<std::string> body)>;
+
+  void PostJson(const std::string& method,
+                const std::string& path,
+                const std::string& header_name,
+                const std::string& header_value,
+                base::Value::Dict body,
+                HttpResponseCallback callback);
+
+  raw_ptr<network::mojom::URLLoaderFactory> url_loader_factory_;
+  std::string base_url_;
+  std::string api_key_;
+
+  base::WeakPtrFactory<QuickDeskApiClient> weak_factory_{this};
+};
+
+}  // namespace remoting
+
+#endif  // REMOTING_QUICKDESK_SIGNALING_QUICKDESK_API_CLIENT_H_
