+
+class QuickDeskClient;
+
+// Native messaging host for the QuickDesk client process. Speaks the JSON
+// protocol used by the Qt layer and drives one QuickDeskClient per
+// connection.
+class QuickDeskNativeMessagingClient : public extensions::NativeMessageHost {
+ public:
+  // |task_runner| is normally an AutoThreadTaskRunner tying the process
+  // lifetime to the native messaging channel.
+  explicit QuickDeskNativeMessagingClient(
+      scoped_refptr<base::SingleThreadTaskRunner> task_runner);
+  ~QuickDeskNativeMessagingClient() override;
+
+  QuickDeskNativeMessagingClient(const QuickDeskNativeMessagingClient&) =
+      delete;
+  QuickDeskNativeMessagingClient& operator=(
+      const QuickDeskNativeMessagingClient&) = delete;
+
+  // extensions::NativeMessageHost implementation.
+  void OnMessage(const std::string& message) override;
+  void Start(Client* client) override;
+  scoped_refptr<base::SingleThreadTaskRunner> task_runner() const override;
+
+ private:
+  class SessionObserver;
+  struct Session;
+
+  void ProcessHello(const base::Value::Dict& message);
+  void ProcessConnectToHost(const base::Value::Dict& message);
+  void ProcessDisconnectFromHost(const base::Value::Dict& message);
+  void ProcessDisconnectAll();
+  void ProcessMouseEvent(const base::Value::Dict& message);
+  void ProcessKeyboardEvent(const base::Value::Dict& message);
+  void ProcessClipboardSync(const base::Value::Dict& message);
+  void ProcessSendAction(const base::Value::Dict& message);
+  void ProcessSkillBridgeSend(const base::Value::Dict& message);
+
+  // Called by SessionObserver.
+  void OnSessionState(const std::string& connection_id,
+                      protocol::ConnectionToHost::State state,
+                      protocol::ErrorCode error);
+  void OnSessionFrameReady(const std::string& connection_id,
+                           const std::string& shared_memory_name,
+                           int width,
+                           int height,
+                           uint32_t frame_index);
+  void OnSessionClipboard(const std::string& connection_id,
+                          const std::string& text);
+  void OnSessionCursorShape(const std::string& connection_id,
+                            int width,
+                            int height,
+                            int hotspot_x,
+                            int hotspot_y,
+                            const std::string& data);
+  void OnSessionExtensionMessage(const std::string& connection_id,
+                                 const std::string& type,
+                                 const std::string& data);
+
+  Session* FindSession(const std::string& connection_id);
+  void ScheduleDestroySession(const std::string& connection_id);
+  void DestroySession(const std::string& connection_id);
+  void DestroyAllSessions();
+
+  void SendMessage(base::Value::Dict message) const;
+  void SendError(const std::string& connection_id,
+                 const std::string& code,
+                 const std::string& message) const;
+
+  scoped_refptr<base::SingleThreadTaskRunner> task_runner_;
+  raw_ptr<Client> client_ = nullptr;
+  std::map<std::string, std::unique_ptr<Session>> sessions_;
+  std::string preferred_video_codec_;
+
+  base::WeakPtrFactory<QuickDeskNativeMessagingClient> weak_factory_{this};
+};
+
+}  // namespace remoting
+
+#endif  // REMOTING_QUICKDESK_CLIENT_CLI_QUICKDESK_NATIVE_MESSAGING_CLIENT_H_
