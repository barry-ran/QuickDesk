+
+namespace remoting {
+
+namespace {
+
+constexpr char kSignalPath[] = "/v1/realtime/signal";
+constexpr size_t kMaxResponseBodySize = 1024 * 1024;
+
+net::NetworkTrafficAnnotationTag GetTrafficAnnotation() {
+  static const net::NetworkTrafficAnnotationTag tag =
+      net::DefineNetworkTrafficAnnotation("quickdesk_device_api", R"(
+        semantics {
+          sender: "QuickDesk"
+          description:
+            "Device provisioning, heartbeat and access-code requests sent to "
+            "the QuickDesk signaling server."
+          trigger: "User starts hosting or a session ends."
+          data: "Device identifier, machine fingerprint, OS version, "
+                "application version and access code."
+          destination: OTHER
+          destination_other: "The QuickDesk signaling server configured by "
+                             "the user."
+        }
+        policy {
+          cookies_allowed: NO
+          setting: "This feature cannot be disabled in settings."
+          policy_exception_justification: "Not implemented."
+        }
+      )");
+  return tag;
+}
+
+std::string FormatHttpError(int response_code,
+                            const std::optional<std::string>& body) {
+  std::string error =
+      base::StringPrintf("HTTP %d", response_code);
+  if (body && !body->empty()) {
+    std::string trimmed = body->substr(0, 300);
+    error += ": " + trimmed;
+  }
+  return error;
+}
+
+bool IsSuccess(int response_code) {
+  return response_code >= 200 && response_code < 300;
+}
+
+}  // namespace
+
+QuickDeskApiClient::QuickDeskApiClient(
+    network::mojom::URLLoaderFactory* url_loader_factory,
+    const std::string& server_url,
+    const std::string& api_key)
+    : url_loader_factory_(url_loader_factory),
+      base_url_(GetHttpBaseUrl(server_url)),
+      api_key_(api_key) {}
+
+QuickDeskApiClient::~QuickDeskApiClient() = default;
+
+void QuickDeskApiClient::Provision(const std::string& device_uuid,
+                                   const std::string& machine_fingerprint,
+                                   const std::string& os,
+                                   const std::string& os_version,
+                                   const std::string& app_version,
+                                   ProvisionCallback callback) {
+  base::Value::Dict body;
+  body.Set("device_uuid", device_uuid);
+  body.Set("machine_fingerprint", machine_fingerprint);
+  body.Set("os", os);
+  body.Set("os_version", os_version);
+  body.Set("app_version", app_version);
+
+  PostJson(
+      "POST", "/v1/devices:provision", "X-API-Key", api_key_, std::move(body),
+      base::BindOnce(
+          [](ProvisionCallback callback, int response_code,
+             std::optional<std::string> body) {
+            if (!IsSuccess(response_code) || !body) {
+              std::move(callback).Run(std::nullopt,
+                                      FormatHttpError(response_code, body));
+              return;
+            }
+            std::optional<base::Value::Dict> dict =
+                base::JSONReader::ReadDict(*body);
+            if (!dict) {
+              std::move(callback).Run(std::nullopt, "Invalid JSON response");
+              return;
+            }
+            const std::string* device_id = dict->FindString("device_id");
+            const std::string* device_secret =
+                dict->FindString("device_secret");
+            if (!device_id || !device_secret) {
+              std::move(callback).Run(
+                  std::nullopt, "Provision response missing device fields");
+              return;
+            }
+            ProvisionResult result;
+            result.device_id = *device_id;
+            result.device_secret = *device_secret;
+            result.is_new = dict->FindBool("is_new").value_or(false);
+            std::move(callback).Run(std::move(result), std::string());
+          },
+          std::move(callback)));
+}
+
+void QuickDeskApiClient::IssueSignalToken(const std::string& device_id,
+                                          const std::string& device_secret,
+                                          TokenCallback callback) {
+  PostJson(
+      "POST", "/v1/devices/" + device_id + "/signal-tokens", "Authorization",
+      "Bearer " + device_secret, base::Value::Dict(),
+      base::BindOnce(
+          [](TokenCallback callback, int response_code,
+             std::optional<std::string> body) {
+            if (!IsSuccess(response_code) || !body) {
+              std::move(callback).Run(
+                  std::string(), FormatHttpError(response_code, body));
+              return;
+            }
+            std::optional<base::Value::Dict> dict =
+                base::JSONReader::ReadDict(*body);
+            if (!dict) {
+              std::move(callback).Run(std::string(),
+                                      "Invalid JSON response");
+              return;
+            }
+            const std::string* token = dict->FindString("signal_token");
+            if (!token || token->empty()) {
+              std::move(callback).Run(std::string(),
+                                      "Response missing signal_token");
+              return;
+            }
+            std::move(callback).Run(*token, std::string());
+          },
+          std::move(callback)));
+}
+
+void QuickDeskApiClient::Heartbeat(const std::string& device_id,
+                                   const std::string& device_secret,
+                                   const std::string& app_version,
+                                   const std::string& os,
+                                   const std::string& os_version,
+                                   ResultCallback callback) {
+  base::Value::Dict body;
+  body.Set("app_version", app_version);
+  body.Set("os", os);
+  body.Set("os_version", os_version);
+
+  PostJson(
+      "POST", "/v1/devices/" + device_id + "/heartbeat", "Authorization",
+      "Bearer " + device_secret, std::move(body),
+      base::BindOnce(
+          [](ResultCallback callback, int response_code,
+             std::optional<std::string> body) {
+            if (!IsSuccess(response_code)) {
+              std::move(callback).Run(false,
+                                      FormatHttpError(response_code, body));
+              return;
+            }
+            std::move(callback).Run(true, std::string());
+          },
+          std::move(callback)));
+}
+
+void QuickDeskApiClient::SetAccessCode(const std::string& device_id,
+                                       const std::string& device_secret,
+                                       const std::string& access_code,
+                                       ResultCallback callback) {
+  base::Value::Dict body;
+  body.Set("access_code", access_code);
+
+  PostJson(
+      "PUT", "/v1/devices/" + device_id + "/access-code", "Authorization",
+      "Bearer " + device_secret, std::move(body),
+      base::BindOnce(
+          [](ResultCallback callback, int response_code,
+             std::optional<std::string> body) {
+            if (!IsSuccess(response_code)) {
+              std::move(callback).Run(false,
+                                      FormatHttpError(response_code, body));
+              return;
+            }
+            std::move(callback).Run(true, std::string());
+          },
+          std::move(callback)));
+}
+
+// static
+std::string QuickDeskApiClient::GetHttpBaseUrl(const std::string& server_url) {
+  std::string url = std::string(
+      base::TrimWhitespaceASCII(server_url, base::TRIM_ALL));
+  while (!url.empty() && url.back() == '/') {
+    url.pop_back();
+  }
+
+  if (base::StartsWith(url, "ws://", base::CompareCase::SENSITIVE)) {
+    url = "http://" + url.substr(5);
+  } else if (base::StartsWith(url, "wss://", base::CompareCase::SENSITIVE)) {
+    url = "https://" + url.substr(6);
+  } else if (!base::StartsWith(url, "http://", base::CompareCase::SENSITIVE) &&
+             !base::StartsWith(url, "https://", base::CompareCase::SENSITIVE) &&
+             !url.empty()) {
+    url = "http://" + url;
+  }
+
+  if (base::EndsWith(url, kSignalPath, base::CompareCase::SENSITIVE)) {
+    url.resize(url.size() - std::string(kSignalPath).size());
+  }
+  while (!url.empty() && url.back() == '/') {
+    url.pop_back();
+  }
+  return url;
+}
+
+// static
+std::string QuickDeskApiClient::GetSignalUrl(const std::string& server_url) {
+  std::string url = std::string(
+      base::TrimWhitespaceASCII(server_url, base::TRIM_ALL));
+  while (!url.empty() && url.back() == '/') {
+    url.pop_back();
+  }
+  if (url.empty()) {
+    return url;
+  }
+
+  const bool has_signal_path =
+      base::EndsWith(url, kSignalPath, base::CompareCase::SENSITIVE);
+
+  if (base::StartsWith(url, "http://", base::CompareCase::SENSITIVE)) {
+    url = "ws://" + url.substr(7);
+  } else if (base::StartsWith(url, "https://", base::CompareCase::SENSITIVE)) {
+    url = "wss://" + url.substr(8);
+  } else if (!base::StartsWith(url, "ws://", base::CompareCase::SENSITIVE) &&
+             !base::StartsWith(url, "wss://", base::CompareCase::SENSITIVE)) {
+    url = "ws://" + url;
+  }
+
+  if (!has_signal_path) {
+    url += kSignalPath;
+  }
+  return url;
+}
+
+void QuickDeskApiClient::PostJson(const std::string& method,
+                                  const std::string& path,
+                                  const std::string& header_name,
+                                  const std::string& header_value,
+                                  base::Value::Dict body,
+                                  HttpResponseCallback callback) {
+  if (!url_loader_factory_) {
+    std::move(callback).Run(0, std::nullopt);
+    return;
+  }
+
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = GURL(base_url_ + path);
+  request->method = method;
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  request->headers.SetHeader("Content-Type", "application/json");
+  request->headers.SetHeader("Accept", "application/json");
+  // The server gates the whole v1 API on the API key; device-secret endpoints
+  // require it in addition to the Bearer token.
+  if (!api_key_.empty()) {
+    request->headers.SetHeader("X-API-Key", api_key_);
+  }
+  if (!header_name.empty() && !header_value.empty()) {
+    request->headers.SetHeader(header_name, header_value);
+  }
+
+  std::string body_json;
+  base::JSONWriter::Write(base::Value(std::move(body)), &body_json);
+
+  auto loader = network::SimpleURLLoader::Create(std::move(request),
+                                                 GetTrafficAnnotation());
+  // Chromium 140 requires uploads to be attached through the streaming API;
+  // setting ResourceRequestBody bytes directly trips a DCHECK.
+  loader->AttachStringForUpload(std::move(body_json), "application/json");
+  loader->SetTimeoutDuration(base::Seconds(20));
+
+  loader->DownloadToString(
+      url_loader_factory_,
+      base::BindOnce(
+          [](std::unique_ptr<network::SimpleURLLoader> loader,
+             HttpResponseCallback callback,
+             std::optional<std::string> body) {
+            int response_code = 0;
+            if (loader->ResponseInfo() && loader->ResponseInfo()->headers) {
+              response_code =
+                  loader->ResponseInfo()->headers->response_code();
+            } else if (loader->NetError() != net::OK) {
+              LOG(WARNING) << "QuickDesk API request failed: "
+                           << net::ErrorToString(loader->NetError());
+            }
+            std::move(callback).Run(response_code, std::move(body));
+          },
+          std::move(loader), std::move(callback)),
+      kMaxResponseBodySize);
+}
+
+}  // namespace remoting
