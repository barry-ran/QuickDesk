+void QuickDeskHost::OnSignalStrategyStateChange(SignalStrategy::State state) {
+  DCHECK(host_context_->network_task_runner()->BelongsToCurrentThread());
+
+  std::string state_string;
+  int retry_count = 0;
+  int next_retry_in_seconds = 0;
+  std::string error;
+
+  switch (state) {
+    case SignalStrategy::CONNECTING:
+      state_string = "connecting";
+      break;
+    case SignalStrategy::CONNECTED:
+      state_string = "connected";
+      break;
+    case SignalStrategy::DISCONNECTED:
+      state_string = "disconnected";
+      if (signal_strategy_) {
+        retry_count = signal_strategy_->reconnect_count();
+        next_retry_in_seconds = signal_strategy_->next_retry_in_seconds();
+        error = signal_strategy_->last_error_message();
+      }
+      break;
+  }
+
+  host_context_->ui_task_runner()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&QuickDeskHost::Observer::OnSignalingStateChanged,
+                     observer_, state_string, retry_count,
+                     next_retry_in_seconds, error));
+}
