+// found in the LICENSE file.
+
+#ifndef REMOTING_QUICKDESK_CLIENT_COMMON_SHARED_MEMORY_FRAME_CONSUMER_H_
+#define REMOTING_QUICKDESK_CLIENT_COMMON_SHARED_MEMORY_FRAME_CONSUMER_H_
+
+#include <cstdint>
+#include <memory>
+#include <string>
+
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr_exclusion.h"
+#include "base/sequence_checker.h"
+#include "remoting/protocol/frame_consumer.h"
+
+namespace webrtc {
+class DesktopFrame;
+class DesktopSize;
+}  // namespace webrtc
+
+namespace remoting {
+
+// Consumes decoded BGRA frames from WebrtcVideoRendererAdapter, converts them
+// to I420 and publishes them in a POSIX shared memory region laid out exactly
+// as QuickDesk's SharedFrameHeader (see Qt SharedMemoryManager.h).
+class SharedMemoryFrameConsumer : public protocol::FrameConsumer {
+ public:
+  // |shared_memory_name| must be a POSIX shared memory name starting with '/'.
+  using FrameReadyCallback =
+      base::RepeatingCallback<void(int width, int height, uint32_t frame_index)>;
+
+  SharedMemoryFrameConsumer(std::string shared_memory_name,
+                            FrameReadyCallback frame_ready_callback);
+  ~SharedMemoryFrameConsumer() override;
+
+  SharedMemoryFrameConsumer(const SharedMemoryFrameConsumer&) = delete;
+  SharedMemoryFrameConsumer& operator=(const SharedMemoryFrameConsumer&) = delete;
+
+  const std::string& shared_memory_name() const { return shared_memory_name_; }
+
+  // protocol::FrameConsumer implementation.
+  std::unique_ptr<webrtc::DesktopFrame> AllocateFrame(
+      const webrtc::DesktopSize& size) override;
+  void DrawFrame(std::unique_ptr<webrtc::DesktopFrame> frame,
+                 base::OnceClosure done) override;
+  PixelFormat GetPixelFormat() override;
+
+ private:
+  bool EnsureInitialized(int width, int height);
+  void ReleaseRegion();
+
+  const std::string shared_memory_name_;
+  const FrameReadyCallback frame_ready_callback_;
+  [[maybe_unused]] base::SequenceChecker sequence_checker_;
+
+  int fd_ = -1;
+  // RAW_PTR_EXCLUSION: points into a mmap()ed shared memory region, not
+  // PartitionAlloc-managed memory.
+  RAW_PTR_EXCLUSION uint8_t* data_ = nullptr;
+  size_t mapped_size_ = 0;
+  uint32_t frame_index_ = 0;
+};
+
+}  // namespace remoting
+
+#endif  // REMOTING_QUICKDESK_CLIENT_COMMON_SHARED_MEMORY_FRAME_CONSUMER_H_
