+bool QuickDeskHost::ReadPersistedHostState(std::string* device_id,
+                                           std::string* access_code,
+                                           std::string* device_secret) {
+  std::string content;
+  if (!base::ReadFileToString(GetHostStateFilePath(), &content)) {
+    return false;
+  }
+  std::optional<base::Value::Dict> dict = base::JSONReader::ReadDict(content);
+  if (!dict) {
+    return false;
+  }
+  if (device_id) {
+    *device_id = GetStringField(*dict, kDeviceIdKey);
+  }
+  if (access_code) {
+    *access_code = GetStringField(*dict, kAccessCodeKey);
+  }
+  if (device_secret) {
+    *device_secret = GetStringField(*dict, kDeviceSecretKey);
+  }
+  return true;
+}
