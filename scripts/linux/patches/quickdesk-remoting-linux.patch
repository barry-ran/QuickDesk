+// found in the LICENSE file.
+
+#ifndef REMOTING_QUICKDESK_HOST_QUICKDESK_SKILL_EXTENSION_H_
+#define REMOTING_QUICKDESK_HOST_QUICKDESK_SKILL_EXTENSION_H_
+
+#include <memory>
+#include <string>
+
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "remoting/host/host_extension.h"
+#include "remoting/host/host_extension_session.h"
+
+namespace remoting {
+
+namespace protocol {
+class ClientStub;
+class ExtensionMessage;
+}  // namespace protocol
+
+class QuickDeskSkillExtensionSession;
+
+// Bridges skill requests between the Qt host layer and a connected client over
+// Chromium's host-extension message channel. The extension is only
+// instantiated for clients that negotiate the "quickdesk-skill" capability.
+class QuickDeskSkillExtension : public HostExtension {
+ public:
+  using SkillMessageCallback =
+      base::RepeatingCallback<void(const std::string& data)>;
+  using SessionCreatedCallback = base::RepeatingCallback<void(
+      base::WeakPtr<QuickDeskSkillExtensionSession> session)>;
+
+  QuickDeskSkillExtension(SkillMessageCallback on_message,
+                          SessionCreatedCallback on_session_created);
+  ~QuickDeskSkillExtension() override;
+
+  QuickDeskSkillExtension(const QuickDeskSkillExtension&) = delete;
+  QuickDeskSkillExtension& operator=(const QuickDeskSkillExtension&) = delete;
+
+  // HostExtension implementation.
+  std::string capability() const override;
+  std::unique_ptr<HostExtensionSession> CreateExtensionSession(
+      ClientSessionDetails* client_session_details,
+      protocol::ClientStub* client_stub) override;
+
+ private:
+  SkillMessageCallback on_message_;
+  SessionCreatedCallback on_session_created_;
+};
+
+// Per-client extension session. Owned by HostExtensionSessionManager and
+// lives on the network thread.
+class QuickDeskSkillExtensionSession : public HostExtensionSession {
+ public:
+  QuickDeskSkillExtensionSession(
+      QuickDeskSkillExtension::SkillMessageCallback on_message,
+      protocol::ClientStub* client_stub);
+  ~QuickDeskSkillExtensionSession() override;
+
+  QuickDeskSkillExtensionSession(const QuickDeskSkillExtensionSession&) =
+      delete;
+  QuickDeskSkillExtensionSession& operator=(
+      const QuickDeskSkillExtensionSession&) = delete;
+
+  // HostExtensionSession implementation.
+  bool OnExtensionMessage(
+      ClientSessionDetails* client_session_details,
+      protocol::ClientStub* client_stub,
+      const protocol::ExtensionMessage& message) override;
+
+  // Sends a skill message to the connected client.
+  void SendSkillMessage(const std::string& data);
+
+  base::WeakPtr<QuickDeskSkillExtensionSession> GetWeakPtr();
+
+ private:
+  QuickDeskSkillExtension::SkillMessageCallback on_message_;
+  raw_ptr<protocol::ClientStub> client_stub_;
+  base::WeakPtrFactory<QuickDeskSkillExtensionSession> weak_factory_{this};
+};
+
+}  // namespace remoting
+
+#endif  // REMOTING_QUICKDESK_HOST_QUICKDESK_SKILL_EXTENSION_H_
