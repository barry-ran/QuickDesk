+  if (base::ReadFileToString(base::FilePath("/etc/machine-id"),
+                             &machine_id)) {
+    return std::string(
+        base::TrimWhitespaceASCII(machine_id, base::TRIM_ALL));
+  }
+  return std::string();
+}
