new file mode 100644
index 0000000000..454446794f
--- /dev/null
+++ b/remoting/quickdesk/client/common/shared_memory_frame_consumer.cc
@@ -0,0 +1,221 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "remoting/quickdesk/client/common/shared_memory_frame_consumer.h"
+
+#ifdef UNSAFE_BUFFERS_BUILD
+// The frame header and the I420 planes are laid out manually in a mmap()ed
+// region, so this file necessarily does raw pointer arithmetic on it.
+#pragma allow_unsafe_buffers
+#endif
+
+#include <fcntl.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include <algorithm>
+#include <cerrno>
+#include <cstring>
+#include <utility>
+
+#include "base/logging.h"
+#include "base/time/time.h"
+#include "third_party/libyuv/include/libyuv/convert.h"
+#include "third_party/webrtc/modules/desktop_capture/desktop_frame.h"
+
+namespace remoting {
+
+namespace {
+
+// Must match QuickDesk's SharedFrameHeader in Qt SharedMemoryManager.h.
+constexpr uint32_t kSharedFrameMagic = 0x51444656;  // "QDVF"
+constexpr uint32_t kSharedFrameVersion = 1;
+constexpr uint32_t kSharedFrameFormatI420 = 3;
+
+#pragma pack(push, 1)
+struct SharedFrameHeader {
+  uint32_t magic;
+  uint32_t version;
+  uint32_t width;
+  uint32_t height;
+  uint32_t format;
+  uint32_t frame_index;
+  uint64_t timestamp_us;
+  uint32_t data_size;
+  uint32_t y_stride;
+  uint32_t u_stride;
+  uint32_t v_stride;
+  uint32_t reserved[4];
+};
+#pragma pack(pop)
+
+static_assert(sizeof(SharedFrameHeader) == 64,
+              "SharedFrameHeader must match the Qt layout");
+
+// Cap the region at 4K UHD worth of I420 pixels. The region is provisioned at
+// this size up front (sparsely, so untouched pages cost nothing) because the
+// Qt side attaches once per device and cannot remap a grown segment.
+constexpr int kMaxDimension = 4096;
+constexpr size_t kMaxPackedSize = 3840 * 2160 * 3 / 2;
+
+size_t I420Size(int width, int height) {
+  return static_cast<size_t>(width) * height +
+         static_cast<size_t>(width / 2) * (height / 2) * 2;
+}
+
+}  // namespace
+
+SharedMemoryFrameConsumer::SharedMemoryFrameConsumer(
+    std::string shared_memory_name,
+    FrameReadyCallback frame_ready_callback)
+    : shared_memory_name_(std::move(shared_memory_name)),
+      frame_ready_callback_(std::move(frame_ready_callback)) {
+  CHECK(!shared_memory_name_.empty());
+  CHECK_EQ(shared_memory_name_.front(), '/')
+      << "POSIX shared memory names must start with '/': "
+      << shared_memory_name_;
+  DETACH_FROM_SEQUENCE(sequence_checker_);
+}
+
+SharedMemoryFrameConsumer::~SharedMemoryFrameConsumer() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  ReleaseRegion();
+}
+
+std::unique_ptr<webrtc::DesktopFrame> SharedMemoryFrameConsumer::AllocateFrame(
+    const webrtc::DesktopSize& size) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  return std::make_unique<webrtc::BasicDesktopFrame>(size);
+}
+
+void SharedMemoryFrameConsumer::DrawFrame(
+    std::unique_ptr<webrtc::DesktopFrame> frame,
+    base::OnceClosure done) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+
+  if (!frame) {
+    std::move(done).Run();
+    return;
+  }
+
+  // I420 requires even dimensions; Qt validates the packed plane sizes using
+  // integer division, so odd sizes would be rejected there as well.
+  const int width = frame->size().width() & ~1;
+  const int height = frame->size().height() & ~1;
+  if (width <= 0 || height <= 0) {
+    std::move(done).Run();
+    return;
+  }
+
+  if (!EnsureInitialized(width, height)) {
+    std::move(done).Run();
+    return;
+  }
+
+  uint8_t* planes = data_ + sizeof(SharedFrameHeader);
+  const int y_stride = width;
+  const int uv_stride = width / 2;
+  uint8_t* y_plane = planes;
+  uint8_t* u_plane = y_plane + static_cast<size_t>(y_stride) * height;
+  uint8_t* v_plane = u_plane + static_cast<size_t>(uv_stride) * (height / 2);
+
+  libyuv::ARGBToI420(frame->data(), frame->stride(), y_plane, y_stride, u_plane,
+                     uv_stride, v_plane, uv_stride, width, height);
+
+  auto* header = reinterpret_cast<SharedFrameHeader*>(data_);
+  header->timestamp_us =
+      static_cast<uint64_t>(base::Time::Now().since_origin().InMicroseconds());
+  header->data_size = static_cast<uint32_t>(I420Size(width, height));
+  header->y_stride = static_cast<uint32_t>(y_stride);
+  header->u_stride = static_cast<uint32_t>(uv_stride);
+  header->v_stride = static_cast<uint32_t>(uv_stride);
+  header->width = static_cast<uint32_t>(width);
+  header->height = static_cast<uint32_t>(height);
+  header->frame_index = ++frame_index_;
+
+  frame_ready_callback_.Run(width, height, frame_index_);
+  std::move(done).Run();
+}
+
+protocol::FrameConsumer::PixelFormat
+SharedMemoryFrameConsumer::GetPixelFormat() {
+  return FORMAT_BGRA;
+}
+
+bool SharedMemoryFrameConsumer::EnsureInitialized(int width, int height) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+
+  if (width > kMaxDimension || height > kMaxDimension ||
+      I420Size(width, height) > kMaxPackedSize) {
+    LOG(WARNING) << "Dropping frame larger than supported: " << width << "x"
+                 << height;
+    return false;
+  }
+
+  if (data_) {
+    return true;
+  }
+
+  const size_t total_size = sizeof(SharedFrameHeader) + kMaxPackedSize;
+
+  fd_ = shm_open(shared_memory_name_.c_str(), O_CREAT | O_EXCL | O_RDWR, 0600);
+  if (fd_ < 0 && errno == EEXIST) {
+    shm_unlink(shared_memory_name_.c_str());
+    fd_ = shm_open(shared_memory_name_.c_str(), O_CREAT | O_EXCL | O_RDWR, 0600);
+  }
+  if (fd_ < 0) {
+    LOG(ERROR) << "shm_open(" << shared_memory_name_
+               << ") failed: " << std::strerror(errno);
+    return false;
+  }
+
+  if (ftruncate(fd_, static_cast<off_t>(total_size)) != 0) {
+    LOG(ERROR) << "ftruncate(" << shared_memory_name_
+               << ") failed: " << std::strerror(errno);
+    ReleaseRegion();
+    return false;
+  }
+
+  void* mapping = mmap(nullptr, total_size, PROT_READ | PROT_WRITE, MAP_SHARED,
+                       fd_, 0);
+  if (mapping == MAP_FAILED) {
+    LOG(ERROR) << "mmap(" << shared_memory_name_
+               << ") failed: " << std::strerror(errno);
+    ReleaseRegion();
+    return false;
+  }
+
+  data_ = static_cast<uint8_t*>(mapping);
+  mapped_size_ = total_size;
+
+  auto* header = reinterpret_cast<SharedFrameHeader*>(data_);
+  memset(header, 0, sizeof(SharedFrameHeader));
+  header->magic = kSharedFrameMagic;
+  header->version = kSharedFrameVersion;
+  header->format = kSharedFrameFormatI420;
+
+  LOG(INFO) << "Created shared memory " << shared_memory_name_ << " ("
+            << total_size << " bytes)";
+  return true;
+}
+
+void SharedMemoryFrameConsumer::ReleaseRegion() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+
+  if (data_) {
+    munmap(data_, mapped_size_);
+    data_ = nullptr;
+    mapped_size_ = 0;
+  }
+  if (fd_ >= 0) {
+    close(fd_);
+    fd_ = -1;
+  }
+  if (!shared_memory_name_.empty()) {
+    shm_unlink(shared_memory_name_.c_str());
+  }
+}
+
+}  // namespace remoting
