+void QuickDeskNativeMessagingHost::OnHostReady(
+    const std::string& device_id,
+    const std::string& access_code,
+    const std::string& device_secret) {
+  DCHECK(task_runner()->BelongsToCurrentThread());
+
+  access_code_ = access_code;
+
+  base::Value::Dict message;
+  message.Set(kMessageType, kHostReadyMessage);
+  message.Set(kDeviceId, device_id);
+  message.Set(kAccessCode, access_code);
+  message.Set(kDeviceSecret, device_secret);
+  SendMessageToClient(std::move(message));
+}
+
+void QuickDeskNativeMessagingHost::OnAccessCodeChanged(
+    const std::string& access_code) {
+  DCHECK(task_runner()->BelongsToCurrentThread());
+
+  access_code_ = access_code;
+
+  base::Value::Dict message;
+  message.Set(kMessageType, kAccessCodeChangedMessage);
+  message.Set(kAccessCode, access_code);
+  SendMessageToClient(std::move(message));
+}
+
+void QuickDeskNativeMessagingHost::OnRefreshAccessCodeResult(
+    bool success,
+    const std::string& error_code,
+    const std::string& error_message) {
+  DCHECK(task_runner()->BelongsToCurrentThread());
+
+  base::Value::Dict message;
+  message.Set(kMessageType, kRefreshAccessCodeResponse);
+  message.Set(kSuccess, success);
+  if (success) {
+    message.Set(kAccessCode, access_code_);
+  } else {
+    message.Set(kSignalingError, error_code);
+    message.Set(kErrorMessageField, error_message);
+  }
+  SendMessageToClient(std::move(message));
+}
+
+void QuickDeskNativeMessagingHost::OnSignalingStateChanged(
+    const std::string& state,
+    int retry_count,
+    int next_retry_in_seconds,
+    const std::string& error) {
+  DCHECK(task_runner()->BelongsToCurrentThread());
+
+  base::Value::Dict message;
+  message.Set(kMessageType, kSignalingStateChangedMessage);
+  message.Set(kState, state);
+  message.Set(kRetryCount, retry_count);
+  message.Set(kNextRetryIn, next_retry_in_seconds);
+  message.Set(kSignalingError, error);
+  SendMessageToClient(std::move(message));
+}
