+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "remoting/quickdesk/host/quickdesk_skill_extension.h"
+
+#include <memory>
+#include <utility>
+
+#include "base/check.h"
+#include "remoting/proto/control.pb.h"
+#include "remoting/protocol/client_stub.h"
+
+namespace remoting {
+
+namespace {
+
+// Keep in sync with QuickDeskClient's capability in quickdesk_client.cc.
+// Must match the capability name used by released QuickDesk builds.
+constexpr char kQuickDeskSkillCapability[] = "qd-skill-bridge";
+constexpr char kSkillMessageType[] = "skillMessage";
+
+}  // namespace
+
+QuickDeskSkillExtension::QuickDeskSkillExtension(
+    SkillMessageCallback on_message,
+    SessionCreatedCallback on_session_created)
+    : on_message_(std::move(on_message)),
+      on_session_created_(std::move(on_session_created)) {
+  CHECK(on_message_);
+}
+
+QuickDeskSkillExtension::~QuickDeskSkillExtension() = default;
+
+std::string QuickDeskSkillExtension::capability() const {
+  return kQuickDeskSkillCapability;
+}
+
+std::unique_ptr<HostExtensionSession>
+QuickDeskSkillExtension::CreateExtensionSession(
+    ClientSessionDetails* client_session_details,
+    protocol::ClientStub* client_stub) {
+  auto session =
+      std::make_unique<QuickDeskSkillExtensionSession>(on_message_, client_stub);
+  if (on_session_created_) {
+    on_session_created_.Run(session->GetWeakPtr());
+  }
+  return session;
+}
+
+QuickDeskSkillExtensionSession::QuickDeskSkillExtensionSession(
+    QuickDeskSkillExtension::SkillMessageCallback on_message,
+    protocol::ClientStub* client_stub)
+    : on_message_(std::move(on_message)), client_stub_(client_stub) {
+  CHECK(client_stub_);
+}
+
+QuickDeskSkillExtensionSession::~QuickDeskSkillExtensionSession() = default;
+
+bool QuickDeskSkillExtensionSession::OnExtensionMessage(
+    ClientSessionDetails* client_session_details,
+    protocol::ClientStub* client_stub,
+    const protocol::ExtensionMessage& message) {
+  if (!message.has_type() || message.type() != kSkillMessageType) {
+    return false;
+  }
+  on_message_.Run(message.data());
+  return true;
+}
+
+void QuickDeskSkillExtensionSession::SendSkillMessage(const std::string& data) {
+  protocol::ExtensionMessage message;
+  message.set_type(kSkillMessageType);
+  message.set_data(data);
+  client_stub_->DeliverHostMessage(message);
+}
+
+base::WeakPtr<QuickDeskSkillExtensionSession>
+QuickDeskSkillExtensionSession::GetWeakPtr() {
+  return weak_factory_.GetWeakPtr();
+}
+
+}  // namespace remoting
