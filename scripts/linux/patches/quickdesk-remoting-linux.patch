+
+void QuickDeskHost::LoadHostState() {
+  std::string content;
+  base::FilePath path = GetHostStateFilePath();
+  if (!base::ReadFileToString(path, &content)) {
+    return;
+  }
+
+  std::optional<base::Value::Dict> dict = base::JSONReader::ReadDict(content);
+  if (!dict) {
+    LOG(WARNING) << "QuickDesk: failed to parse " << path.value();
+    return;
+  }
+
+  device_uuid_ = GetStringField(*dict, kDeviceUuidKey);
+  device_id_ = GetStringField(*dict, kDeviceIdKey);
+  device_secret_ = GetStringField(*dict, kDeviceSecretKey);
+  access_code_ = GetStringField(*dict, kAccessCodeKey);
+
+  LOG(INFO) << "QuickDesk: loaded persisted state, device_id=" << device_id_
+            << ", has_secret=" << !device_secret_.empty();
+}
+
+void QuickDeskHost::PersistHostState() {
+  base::Value::Dict dict;
+  dict.Set(kDeviceUuidKey, device_uuid_);
+  dict.Set(kDeviceIdKey, device_id_);
+  dict.Set(kDeviceSecretKey, device_secret_);
+  dict.Set(kAccessCodeKey, access_code_);
+
+  std::string json;
+  base::JSONWriter::Write(dict, &json);
+
+  // The network thread disallows blocking I/O; hand the write to the file
+  // thread.
+  host_context_->file_task_runner()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&WriteHostStateFile, GetHostStateFilePath(),
+                     std::move(json)));
 }
 
