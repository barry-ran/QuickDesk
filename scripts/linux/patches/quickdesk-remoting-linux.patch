+// Returns the local part of a signaling ID ("user@domain/resource" -> "user").
+std::string GetLocalPart(const std::string& signaling_id) {
+  std::string user = signaling_id;
+  size_t at = user.find('@');
+  if (at != std::string::npos) {
+    user.resize(at);
+  }
+  return user;
+}
+
+std::string GenerateAccessCode() {
+  return base::StringPrintf("%06d", base::RandInt(0, 999999));
+}
