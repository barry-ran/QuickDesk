+QuickDeskNativeMessagingClient::~QuickDeskNativeMessagingClient() {
+  DestroyAllSessions();
+}
+
+void QuickDeskNativeMessagingClient::Start(Client* client) {
+  DCHECK(task_runner()->BelongsToCurrentThread());
+  client_ = client;
+}
+
+scoped_refptr<base::SingleThreadTaskRunner>
+QuickDeskNativeMessagingClient::task_runner() const {
+  return task_runner_;
+}
+
+void QuickDeskNativeMessagingClient::OnMessage(const std::string& message) {
+  DCHECK(task_runner()->BelongsToCurrentThread());
+
+  std::optional<base::Value::Dict> request =
+      base::JSONReader::ReadDict(message);
+  if (!request) {
+    LOG(ERROR) << "Malformed native message";
+    client_->CloseChannel(std::string());
+    return;
+  }
+
+  const std::string* type = request->FindString(kType);
+  if (!type) {
+    LOG(WARNING) << "Native message without a type";
+    return;
+  }
+
+  if (*type == "hello") {
+    ProcessHello(*request);
+  } else if (*type == "connectToHost") {
+    ProcessConnectToHost(*request);
+  } else if (*type == "disconnectFromHost") {
+    ProcessDisconnectFromHost(*request);
+  } else if (*type == "disconnectAll") {
+    ProcessDisconnectAll();
+  } else if (*type == "mouseEvent") {
+    ProcessMouseEvent(*request);
+  } else if (*type == "keyboardEvent") {
+    ProcessKeyboardEvent(*request);
+  } else if (*type == "clipboardSync") {
+    ProcessClipboardSync(*request);
+  } else if (*type == "sendAction") {
+    ProcessSendAction(*request);
+  } else if (*type == "skillBridgeSend") {
+    ProcessSkillBridgeSend(*request);
+  } else {
+    // Newer Qt layers may send messages this process does not implement
+    // (framerate limits, file transfer, skills...). Ignore them instead of
+    // dropping the channel.
+    LOG(INFO) << "Ignoring unsupported message type: " << *type;
+  }
+}
+
+void QuickDeskNativeMessagingClient::ProcessHello(
+    const base::Value::Dict& message) {
+  if (const std::string* codec = message.FindString(kPreferredVideoCodec)) {
+    preferred_video_codec_ = *codec;
+  }
+
+  base::Value::Dict response;
+  response.Set(kType, "helloResponse");
+  response.Set("version", "4.3.1.1");
+  response.Set("protocol_version", kProtocolVersion);
+  // Keyboard capture is not implemented; the Qt layer falls back to the
+  // focused-window key path.
+  response.Set("keyboardCapture", false);
+  SendMessage(std::move(response));
+}
+
+void QuickDeskNativeMessagingClient::ProcessConnectToHost(
+    const base::Value::Dict& message) {
+  const std::string* connection_id = message.FindString(kConnectionId);
+  const std::string* device_id = message.FindString(kDeviceId);
+  const std::string* access_code = message.FindString(kAccessCode);
+  const std::string* signal_token = message.FindString(kSignalToken);
+  const std::string* server_url = message.FindString(kServerUrl);
+
+  if (!connection_id || connection_id->empty() || !device_id ||
+      device_id->empty() || !access_code || !signal_token || !server_url ||
+      server_url->empty()) {
+    SendError(connection_id ? *connection_id : std::string(),
+              "INVALID_ARGUMENT", "connectToHost is missing required fields");
+    return;
+  }
+
+  // A reconnect reuses the device's connection slot only after Qt removed
+  // the old connection, so an existing session with this id is stale.
+  DestroySession(*connection_id);
+
+  QuickDeskClient::Config config;
+  config.connection_id = *connection_id;
+  config.device_id = *device_id;
+  config.access_code = *access_code;
+  config.signal_token = *signal_token;
+  config.server_url = *server_url;
+  config.preferred_video_codec = preferred_video_codec_;
+  if (const std::string* codec = message.FindString(kPreferredVideoCodec)) {
+    config.preferred_video_codec = *codec;
+  }
+  if (const base::Value::Dict* ice_config = message.FindDict(kIceConfig)) {
+    config.ice_config = ice_config->Clone();
+  }
+
+  auto session = std::make_unique<Session>();
+  session->connection_id = *connection_id;
+  session->observer =
+      std::make_unique<SessionObserver>(this, *connection_id);
+  session->client = std::make_unique<QuickDeskClient>(std::move(config),
+                                                      session->observer.get());
+
+  QuickDeskClient* client = session->client.get();
+  sessions_[*connection_id] = std::move(session);
+
+  base::Value::Dict response;
+  response.Set(kType, "connectToHostResponse");
+  response.Set(kConnectionId, *connection_id);
+  SendMessage(std::move(response));
+
+  base::Value::Dict connecting;
+  connecting.Set(kType, "connectionStateChanged");
+  connecting.Set(kConnectionId, *connection_id);
+  connecting.Set("state", "connecting");
+  SendMessage(std::move(connecting));
+
+  client->Start();
+}
+
+void QuickDeskNativeMessagingClient::ProcessDisconnectFromHost(
+    const base::Value::Dict& message) {
+  const std::string* connection_id = message.FindString(kConnectionId);
+  if (!connection_id) {
+    return;
+  }
+
+  DestroySession(*connection_id);
+
+  base::Value::Dict response;
+  response.Set(kType, "disconnectFromHostResponse");
+  response.Set(kConnectionId, *connection_id);
+  SendMessage(std::move(response));
+}
+
+void QuickDeskNativeMessagingClient::ProcessDisconnectAll() {
+  DestroyAllSessions();
+
+  base::Value::Dict response;
+  response.Set(kType, "disconnectAllResponse");
+  SendMessage(std::move(response));
+}
+
+void QuickDeskNativeMessagingClient::ProcessMouseEvent(
+    const base::Value::Dict& message) {
+  const std::string* connection_id = message.FindString(kConnectionId);
+  const std::string* event_type = message.FindString(kEventType);
+  if (!connection_id || !event_type) {
+    return;
+  }
+  Session* session = FindSession(*connection_id);
+  if (!session) {
+    return;
+  }
+
+  const int x = message.FindInt(kX).value_or(session->last_x);
+  const int y = message.FindInt(kY).value_or(session->last_y);
+  session->last_x = x;
+  session->last_y = y;
+
+  if (*event_type == "move") {
+    session->client->SendMouseMove(x, y);
+  } else if (*event_type == "press" || *event_type == "release") {
+    const int button = message.FindInt(kButton).value_or(0);
+    const bool down = *event_type == "press";
+    session->client->SendMouseButton(x, y, button, down);
+    if (down) {
+      session->pressed_buttons.insert(button);
+    } else {
+      session->pressed_buttons.erase(button);
+    }
+  } else if (*event_type == "wheel") {
+    session->client->SendMouseWheel(
+        x, y, message.FindInt(kWheelDeltaX).value_or(0),
+        message.FindInt(kWheelDeltaY).value_or(0));
+  }
+}
+
+void QuickDeskNativeMessagingClient::ProcessKeyboardEvent(
+    const base::Value::Dict& message) {
+  const std::string* event_type = message.FindString(kEventType);
+  if (!event_type) {
+    // Keyboard capture acknowledgements carry no eventType.
+    return;
+  }
+  const std::string* connection_id = message.FindString(kConnectionId);
+  if (!connection_id) {
+    return;
+  }
+  Session* session = FindSession(*connection_id);
+  if (!session) {
+    return;
+  }
+
+  const int native_scan_code = message.FindInt(kNativeScanCode).value_or(0);
+  const int lock_states = message.FindInt(kLockStates).value_or(0);
+  const bool down = *event_type == "press";
+  session->client->SendKeyEvent(native_scan_code, down, lock_states);
+  if (down) {
+    session->pressed_keys.insert(native_scan_code);
+  } else {
+    session->pressed_keys.erase(native_scan_code);
+  }
+}
+
+void QuickDeskNativeMessagingClient::ProcessClipboardSync(
+    const base::Value::Dict& message) {
+  const std::string* connection_id = message.FindString(kConnectionId);
+  const std::string* text = message.FindString(kText);
+  if (!connection_id || !text) {
+    LOG(WARNING) << "clipboardSync: missing connectionId or text";
+    return;
+  }
+  Session* session = FindSession(*connection_id);
+  if (!session) {
+    LOG(WARNING) << "clipboardSync: unknown connection " << *connection_id;
+    return;
+  }
+  session->client->SendClipboardText(*text);
+}
+
+void QuickDeskNativeMessagingClient::ProcessSendAction(
+    const base::Value::Dict& message) {
+  const std::string* connection_id = message.FindString(kConnectionId);
+  const std::string* action = message.FindString(kAction);
+  if (!connection_id || !action) {
+    return;
+  }
+  Session* session = FindSession(*connection_id);
+  if (!session) {
+    return;
+  }
+
+  if (*action != "releaseAllInputAction") {
+    LOG(INFO) << "Ignoring unsupported action: " << *action;
+    return;
+  }
+
+  for (int key : session->pressed_keys) {
+    session->client->SendKeyEvent(key, false, 0);
+  }
+  session->pressed_keys.clear();
+  for (int button : session->pressed_buttons) {
+    session->client->SendMouseButton(session->last_x, session->last_y, button,
+                                     false);
+  }
+  session->pressed_buttons.clear();
+}
+
+void QuickDeskNativeMessagingClient::ProcessSkillBridgeSend(
+    const base::Value::Dict& message) {
+  const std::string* connection_id = message.FindString(kConnectionId);
+  const std::string* data = message.FindString(kData);
+  if (!connection_id || !data) {
+    return;
+  }
+
+  Session* session = FindSession(*connection_id);
+  bool sent = false;
+  if (session) {
+    sent = session->client->SendExtensionMessage("skillMessage", *data);
+  }
+
+  if (sent) {
+    return;
+  }
+
+  // Respond right away so the Qt skill layer does not wait for its timeout.
+  base::Value::Dict response;
+  response.Set(kType, "skillBridgeResponse");
+  response.Set(kConnectionId, *connection_id);
+  response.Set(kData, MakeSkillErrorJson(
+                          "The remote session is not connected or does not "
+                          "support the skill bridge."));
+  SendMessage(std::move(response));
+}
+
+void QuickDeskNativeMessagingClient::OnSessionState(
+    const std::string& connection_id,
+    protocol::ConnectionToHost::State state,
+    protocol::ErrorCode error) {
+  switch (state) {
+    case protocol::ConnectionToHost::CONNECTED: {
+      base::Value::Dict message;
+      message.Set(kType, "connectionStateChanged");
+      message.Set(kConnectionId, connection_id);
+      message.Set("state", "connected");
+      SendMessage(std::move(message));
+      break;
+    }
+    case protocol::ConnectionToHost::FAILED: {
+      base::Value::Dict message;
+      message.Set(kType, "connectionFailed");
+      message.Set(kConnectionId, connection_id);
+      message.Set("errorCode", std::string(ErrorCodeToString(error)));
+      message.Set("message", std::string(ErrorCodeToString(error)));
+      SendMessage(std::move(message));
+      ScheduleDestroySession(connection_id);
+      break;
+    }
+    case protocol::ConnectionToHost::CLOSED: {
+      base::Value::Dict message;
+      message.Set(kType, "onHostDisconnected");
+      message.Set(kConnectionId, connection_id);
+      SendMessage(std::move(message));
+      ScheduleDestroySession(connection_id);
+      break;
+    }
+    case protocol::ConnectionToHost::INITIALIZING:
+    case protocol::ConnectionToHost::CONNECTING:
+    case protocol::ConnectionToHost::AUTHENTICATED:
+      break;
+  }
+}
+
+void QuickDeskNativeMessagingClient::OnSessionFrameReady(
+    const std::string& connection_id,
+    const std::string& shared_memory_name,
+    int width,
+    int height,
+    uint32_t frame_index) {
+  if (!FindSession(connection_id)) {
+    return;
+  }
+
+  base::Value::Dict message;
+  message.Set(kType, "videoFrameReady");
+  message.Set(kConnectionId, connection_id);
+  message.Set("frameIndex", static_cast<int>(frame_index));
+  message.Set("width", width);
+  message.Set("height", height);
+  message.Set("sharedMemoryName", shared_memory_name);
+  SendMessage(std::move(message));
+}
+
+void QuickDeskNativeMessagingClient::OnSessionClipboard(
+    const std::string& connection_id,
+    const std::string& text) {
+  if (!FindSession(connection_id)) {
+    return;
+  }
+
+  base::Value::Dict message;
+  message.Set(kType, "clipboardReceived");
+  message.Set(kConnectionId, connection_id);
+  message.Set(kText, text);
+  SendMessage(std::move(message));
+}
+
+void QuickDeskNativeMessagingClient::OnSessionCursorShape(
+    const std::string& connection_id,
+    int width,
+    int height,
+    int hotspot_x,
+    int hotspot_y,
+    const std::string& data) {
+  if (!FindSession(connection_id)) {
+    return;
+  }
+
+  base::Value::Dict message;
+  message.Set(kType, "cursorShapeChanged");
+  message.Set(kConnectionId, connection_id);
+  message.Set("width", width);
+  message.Set("height", height);
+  message.Set("hotspotX", hotspot_x);
+  message.Set("hotspotY", hotspot_y);
+  if (!data.empty()) {
+    message.Set("data", base::Base64Encode(data));
+  }
+  SendMessage(std::move(message));
+}
+
+void QuickDeskNativeMessagingClient::OnSessionExtensionMessage(
+    const std::string& connection_id,
+    const std::string& type,
+    const std::string& data) {
+  if (type != "skillMessage" || !FindSession(connection_id)) {
+    return;
+  }
+
+  base::Value::Dict message;
+  message.Set(kType, "skillBridgeResponse");
+  message.Set(kConnectionId, connection_id);
+  message.Set(kData, data);
+  SendMessage(std::move(message));
+}
+
+QuickDeskNativeMessagingClient::Session*
+QuickDeskNativeMessagingClient::FindSession(const std::string& connection_id) {
+  auto it = sessions_.find(connection_id);
+  return it == sessions_.end() ? nullptr : it->second.get();
+}
+
+void QuickDeskNativeMessagingClient::ScheduleDestroySession(
+    const std::string& connection_id) {
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&QuickDeskNativeMessagingClient::DestroySession,
+                     weak_factory_.GetWeakPtr(), connection_id));
+}
+
+void QuickDeskNativeMessagingClient::DestroySession(
+    const std::string& connection_id) {
+  auto it = sessions_.find(connection_id);
+  if (it == sessions_.end()) {
+    return;
+  }
+  it->second->client->Stop();
+  sessions_.erase(it);
+}
+
+void QuickDeskNativeMessagingClient::DestroyAllSessions() {
+  for (auto& entry : sessions_) {
+    entry.second->client->Stop();
+  }
+  sessions_.clear();
+}
+
+void QuickDeskNativeMessagingClient::SendMessage(
+    base::Value::Dict message) const {
+  if (!client_) {
+    return;
+  }
+  std::string json;
+  base::JSONWriter::Write(message, &json);
+  client_->PostMessageFromNativeHost(json);
+}
+
+void QuickDeskNativeMessagingClient::SendError(
+    const std::string& connection_id,
+    const std::string& code,
+    const std::string& message) const {
+  base::Value::Dict response;
+  response.Set(kType, "error");
+  if (!connection_id.empty()) {
+    response.Set(kConnectionId, connection_id);
+  }
+  response.Set("code", code);
+  response.Set("message", message);
+  SendMessage(std::move(response));
+}
+
+}  // namespace remoting
