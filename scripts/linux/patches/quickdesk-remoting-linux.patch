+void XServerClipboard::RequestClipboardContent() {
+  if (!connection_ || !connection_->Ready() ||
+      clipboard_window_ == x11::Window::None) {
+    return;
+  }
+
+  if (IsSelectionOwner(clipboard_atom_)) {
+    // We own the selection, so the content is already cached locally.
+    if (!data_.empty()) {
+      callback_.Run(kMimeTypeTextUtf8, data_);
+    }
+    return;
+  }
+
+  // A previous request is still being resolved; OnSetSelectionOwnerNotify
+  // would ignore a second request anyway.
+  if (!get_selections_time_.is_null()) {
+    return;
+  }
+
+  get_selections_time_ = base::TimeTicks::Now();
+  RequestSelectionTargets(clipboard_atom_);
+}
