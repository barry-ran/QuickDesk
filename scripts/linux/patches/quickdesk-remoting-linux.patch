+// Authenticator factory that resolves the shared secret from the current
+// access code for every incoming connection, so the access code can be
+// refreshed without recreating the ChromotingHost.
+class QuickDeskHostAuthenticatorFactory : public protocol::AuthenticatorFactory {
+ public:
+  QuickDeskHostAuthenticatorFactory(
+      scoped_refptr<RsaKeyPair> key_pair,
+      std::string local_certificate,
+      std::string support_id,
+      base::RepeatingCallback<std::string()> access_code_provider,
+      ValidationCallback validation_callback)
+      : key_pair_(std::move(key_pair)),
+        local_certificate_(std::move(local_certificate)),
+        support_id_(std::move(support_id)),
+        access_code_provider_(std::move(access_code_provider)),
+        validation_callback_(std::move(validation_callback)) {}
+
+  ~QuickDeskHostAuthenticatorFactory() override = default;
+
+  std::unique_ptr<protocol::Authenticator> CreateAuthenticator(
+      const std::string& local_jid,
+      const std::string& remote_jid) override {
+    std::string access_code = access_code_provider_.Run();
+    if (access_code.empty()) {
+      LOG(ERROR) << "Cannot create authenticator: access code is not set.";
+      return nullptr;
+    }
+    auto factory = std::make_unique<protocol::It2MeHostAuthenticatorFactory>(
+        local_certificate_, key_pair_, validation_callback_);
+    factory->AddSharedSecretAuth(protocol::GetSharedSecretHash(
+        support_id_, support_id_ + access_code));
+    return factory->CreateAuthenticator(local_jid, remote_jid);
+  }
+
+ private:
+  scoped_refptr<RsaKeyPair> key_pair_;
+  std::string local_certificate_;
+  std::string support_id_;
+  base::RepeatingCallback<std::string()> access_code_provider_;
+  ValidationCallback validation_callback_;
+};
