+
+// Builds the {"error": ...} payload the Qt skill layer understands.
+std::string MakeSkillErrorJson(const std::string& message) {
+  base::Value::Dict error;
+  error.Set("error", message);
+  std::string json;
+  base::JSONWriter::Write(error, &json);
+  return json;
+}
+
+}  // namespace
+
+class QuickDeskNativeMessagingClient::SessionObserver
+    : public ClientStatusObserver {
+ public:
+  SessionObserver(QuickDeskNativeMessagingClient* host,
+                  std::string connection_id)
+      : host_(host), connection_id_(std::move(connection_id)) {}
+
+  void OnConnectionState(protocol::ConnectionToHost::State state,
+                         protocol::ErrorCode error) override {
+    host_->OnSessionState(connection_id_, state, error);
+  }
+
+  void OnFrameReady(const std::string& shared_memory_name,
+                    int width,
+                    int height,
+                    uint32_t frame_index) override {
+    host_->OnSessionFrameReady(connection_id_, shared_memory_name, width,
+                               height, frame_index);
+  }
+
+  void OnClipboardReceived(const std::string& text) override {
+    host_->OnSessionClipboard(connection_id_, text);
+  }
+
+  void OnCursorShapeChanged(int width,
+                            int height,
+                            int hotspot_x,
+                            int hotspot_y,
+                            const std::string& data) override {
+    host_->OnSessionCursorShape(connection_id_, width, height, hotspot_x,
+                                hotspot_y, data);
+  }
+
+  void OnExtensionMessage(const std::string& type,
+                          const std::string& data) override {
+    host_->OnSessionExtensionMessage(connection_id_, type, data);
+  }
+
+ private:
+  raw_ptr<QuickDeskNativeMessagingClient> host_;
+  const std::string connection_id_;
+};
